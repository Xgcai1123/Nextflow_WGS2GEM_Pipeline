// ============================================================
// NextFlow-WGS2GEM — Nextflow configuration
// Bacterial WGS -> genome-scale metabolic model (GEM) pipeline.
// Version is declared in the `manifest` block below and kept in
// sync with CHANGELOG.md and the git tag `v<version>`.
// M0-verified on Nextflow 26.10.0 (strict syntax): projectDir is
// available here (checklist #1); conda.useMamba works (F5).
// ============================================================

manifest {
    name            = 'NextFlow-WGS2GEM'
    author          = 'MeMoModelling'
    description     = 'Bacterial whole-genome sequencing to genome-scale metabolic model: QC, assembly, annotation, model reconstruction and evaluation'
    version         = '0.2.0'
    nextflowVersion = '>=25.10.0'   // onComplete:/strict syntax used by this pipeline
    homePage        = 'https://github.com/MeMoModelling/NextFlow-WGS2GEM'
    mainScript      = 'main.nf'
}

params {
    // ---- project anchors (wfpath() analogue) ----
    project_dir    = projectDir                       // dir of main.nf
    samples_tsv    = "${projectDir}/samples.tsv"
    // ---- inputs (all inside the project: it stands alone) ----
    // `data/` is git-ignored: raw reads, reference databases and NCBI genomes are
    // fetched or supplied, never committed. See docs/asset-sources.md.
    raw_dir        = "${projectDir}/data/raw"
    ref_dir        = "${projectDir}/data/reference"     // F30: optional NCBI references
    bakta_db       = "${projectDir}/data/db/bakta/db-light"
    busco_db       = "${projectDir}/data/db/busco"
    amr_cache      = "${projectDir}/data/cache/amr_guard/known_bad_sequences.tsv"
    scripts_dir    = "${projectDir}/scripts"
    envs_dir       = "${projectDir}/envs"
    bin_dir        = "${projectDir}/bin"
    multiqc_config = "${projectDir}/multiqc_config.yaml"
    multiqc_config_extra = "${projectDir}/multiqc_nextflow.yaml"   // presentation overlay:
                                 // pipeline section order + inline MEMOTE HTML (F21)

    // ---- output dirs: ONE root, grouped by what a reader is looking for ----
    //   results/qc/       every quality report, in one place
    //   results/          the data the pipeline derived (reads, assembly, ...)
    //   results/report/   the reports you show to somebody
    // D23: this deliberately stops mirroring the Snakemake tree. Content is still
    // byte-comparable; only the paths moved.
    raw_qc_dir   = "${projectDir}/results/qc/fastqc_raw"
    trim_dir     = "${projectDir}/results/reads"
    trim_qc_dir  = "${projectDir}/results/qc/fastqc_trimmed"
    assembly_dir = "${projectDir}/results/assembly"
    quast_dir    = "${projectDir}/results/qc/quast"
    refcomp_dir  = "${projectDir}/results/qc/refcompare"  // F30: assembly vs reference
    busco_dir    = "${projectDir}/results/qc/busco"
    annot_dir    = "${projectDir}/results/annotation"
    carveme_dir  = "${projectDir}/results/models/carveme"
    memote_dir   = "${projectDir}/results/models/memote"
    growth_dir   = "${projectDir}/results/models/growth"  // F26: defined-medium growth check
    multiqc_dir  = "${projectDir}/results/report"
    logs_dir     = "${projectDir}/logs"
    bench_dir    = "${projectDir}/benchmarks"

    // ---- workflow params (same names as the Snakemake config keys) ----
    threads_default    = 8
    carveme_solver     = 'scip'
    memote_solver      = 'glpk'
    growth_medium      = "${projectDir}/media/m9_aerobic.yaml"   // F26: versioned medium
    busco_lineage      = 'enterobacterales_odb10'
    quast_min_contig   = 0
    report_tag         = ''
    spades_careful     = '--careful'
    // F20 pre-flight floor: abort before any task if a volume holding work/ or
    // an output directory has less than this much free space. 0 disables it.
    min_free_disk_gb   = 20
    trimmomatic_adapters = ''                       // '' = use the copy shipped in $CONDA_PREFIX

    trim {
        leading       = 3
        trailing      = 3
        slidingwindow = '4:20'
        minlen        = 36
    }
}

process {
    errorStrategy = 'finish'                        // Snakemake --keep-going equivalent
    withName: 'FASTQC_RAW'     { cpus = 4 }
    withName: 'FASTQC_TRIMMED' { cpus = 4 }
    withName: 'TRIMMOMATIC'    { cpus = params.threads_default }
    withName: 'SPADES'         { cpus = params.threads_default }
    withName: 'QUAST'          { cpus = 1 }
    withName: 'BUSCO'          { cpus = 4 }
    withName: 'BAKTA'          { cpus = 4 }
    withName: 'CARVEME'        { cpus = 4 }
    withName: 'MEMOTE'         { cpus = 4 }
    withName: 'MULTIQC'        { cpus = 1 }
}

conda {
    enabled  = true
    useMamba = true                                 // M0 verified (F5)
    cacheDir = "${params.project_dir}/.nextflow/conda"   // mirrors .snakemake/conda
}

workDir = "${params.project_dir}/work"

// Nextflow writes report-<ts>.html / trace-<ts>.txt / timeline / dag into the
// LAUNCH directory by default, which is how ten stray files ended up in the
// project root. Pin them next to the report and switch off the two nobody opens.
//
// NOTE: these blocks are evaluated when the config is PARSED, so they cannot see a
// `-c` overlay (the same trap as F19): mention a param here and a CI overlay would
// still resolve to the real project. They are therefore pinned to projectDir and
// disabled outright in tests/ci/ci.config, so a check can never write into the
// validated results tree.
report   { enabled = true;  overwrite = true; file = "${projectDir}/results/report/nextflow/report.html" }
trace    { enabled = true;  overwrite = true; file = "${projectDir}/results/report/nextflow/trace.tsv" }
timeline { enabled = false }
dag      { enabled = false }

profiles {
    standard { }                                    // 8-core local machine default
    // --set-threads analogue, e.g.: nextflow run . -profile lowmem
    lowmem {
        process {
            withName: 'SPADES'      { cpus = 4 }
            withName: 'TRIMMOMATIC' { cpus = 4 }
        }
    }
}
