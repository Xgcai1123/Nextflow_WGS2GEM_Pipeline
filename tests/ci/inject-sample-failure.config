// ============================================================
// Failure-injection overlay for the single-sample isolation test.
//
//   nextflow -c tests/ci/ci.config -c tests/ci/inject-sample-failure.config \
//           run . -stub-run --min_free_disk_gb=1
//
// `errorStrategy = 'finish'` (nextflow.config) promises that one failing sample
// does not stop the others -- the Snakemake `--keep-going` semantic. Until this
// overlay existed that promise was configuration-only, and CHANGELOG.md listed
// it as an unverified limitation.
//
// The injection deliberately lives in the config layer so that main.nf carries
// no test hook. `beforeScript` is prepended to the task wrapper: it runs before
// input staging, in stub mode exactly as in real mode, and `exit 1` is
// indistinguishable to the engine from a tool that died.
//
// Why the tag is read from the wrapper header: a config-level directive is
// resolved when nextflow.config is parsed, long before a process input such as
// `sample` exists, so `beforeScript` cannot interpolate it -- a plain string is
// emitted verbatim. The task tag, however, is written by Nextflow itself into
// the `### name:` header of the very wrapper being executed, and `$0` points at
// that file. If a future Nextflow renames the header the injection simply stops
// firing; run-failure-isolation.sh asserts that it fired, so that degrades into
// a loud test failure rather than a false pass.
// ============================================================

// Sample killed at its first task; everything downstream of it must be skipped
// while the other sample runs to completion. Override with CI_FAIL_SAMPLE=<name>.
params {
    ci_fail_sample = System.getenv('CI_FAIL_SAMPLE') ?: 'CI_B'
}

process {
    withName: 'FASTQC_RAW' {
        beforeScript = """
        if grep -qE "^### name: 'FASTQC_RAW \\(${params.ci_fail_sample}_(1|2)\\)'" "\$0"; then
            echo "[failure-injection] deliberately failing FASTQC_RAW for sample ${params.ci_fail_sample}"
            exit 1
        fi
        """
    }
}
