// ============================================================
// Negative control for tests/ci/run-failure-isolation.sh.
//
//   nextflow -c tests/ci/ci.config -c tests/ci/inject-sample-failure.config \
//           -c tests/ci/ignore-strategy.config run . -stub-run
//
// `errorStrategy = 'ignore'` is the only Nextflow strategy that would keep
// running branches independent of a failed task -- i.e. the literal reading of
// Snakemake's `--keep-going`. It was measured to be unusable as a default: it
// lets the pipeline exit **0** while a task died, so a real failure disappears
// from CI and from any wrapper script. `finish` is kept deliberately (design
// doc D12); this config exists so the CI check re-measures that rejection and
// fails loudly if a future Nextflow changes `ignore` to report a failure.
// ============================================================

process {
    errorStrategy = 'ignore'
}
