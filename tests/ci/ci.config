// ============================================================
// CI / local smoke-test overrides.
//
//   nextflow -c tests/ci/ci.config run . [-preview | -stub-run]
//
// Two hard rules, both learned the expensive way:
//   1. Never touch the validated output tree (F18: a stub run publishes
//      empty placeholders over real deliverables). Every publishDir target,
//      log dir and benchmark dir is redirected under tests/ci/out/.
//   2. Never build conda environments. The smoke tests run with -stub-run
//      (all ten processes have a stub: block), so no tool has to exist;
//      disabling conda also keeps the job under a minute.
// ============================================================

params {
    // inputs: tiny synthetic reads + the Bakta db-upgrade sentinel
    samples_tsv = "${projectDir}/tests/ci/fixtures/samples.tsv"
    raw_dir     = "${projectDir}/tests/ci/fixtures/raw"
    bakta_db    = "${projectDir}/tests/ci/fixtures/bakta_db"
    busco_db    = "${projectDir}/tests/ci/fixtures/busco_db"

    // outputs: one scratch root, same tree shape as the real layout
    ci_out       = "${projectDir}/tests/ci/out"
    raw_qc_dir   = "${params.ci_out}/data/qc/raw"
    trim_dir     = "${params.ci_out}/data/clean_trimmomatic"
    trim_qc_dir  = "${params.ci_out}/data/qc/trimmed"
    assembly_dir = "${params.ci_out}/assembly/spades"
    quast_dir    = "${params.ci_out}/data/qc/quast"
    busco_dir    = "${params.ci_out}/data/qc/busco"
    annot_dir    = "${params.ci_out}/annotation/bakta"
    carveme_dir  = "${params.ci_out}/models/carveme"
    memote_dir   = "${params.ci_out}/models/memote"
    growth_dir   = "${params.ci_out}/models/growth"
    multiqc_dir  = "${params.ci_out}/reports/multiqc"
    cc_dir       = "${params.ci_out}/reports/multiqc/custom_content"
    logs_dir     = "${params.ci_out}/logs"
    bench_dir    = "${params.ci_out}/benchmarks"
}

conda {
    enabled = false
}

workDir = "${params.ci_out}/work"
