// ============================================================
// CI / local smoke-test overrides.
//
//   nextflow -c tests/ci/ci.config run . [-preview | -stub-run]
//
// Two hard rules, both learned the expensive way:
//   1. Never touch the validated output tree (F18: a stub run publishes
//      empty placeholders over real deliverables). Every publishDir target,
//      log dir and benchmark dir is redirected under tests/ci/out/.
//   2. Never build conda environments. The smoke tests run with -stub-run
//      (all ten processes have a stub: block), so no tool has to exist;
//      disabling conda also keeps the job under a minute.
// ============================================================

params {
    // inputs: tiny synthetic reads + the Bakta db-upgrade sentinel
    samples_tsv = "${projectDir}/tests/ci/fixtures/samples.tsv"
    amr_cache   = "${params.ci_out}/data/cache/amr_guard/known_bad_sequences.tsv"
    raw_dir     = "${projectDir}/tests/ci/fixtures/raw"
    bakta_db    = "${projectDir}/tests/ci/fixtures/bakta_db"
    busco_db    = "${projectDir}/tests/ci/fixtures/busco_db"
    ref_dir     = "${projectDir}/tests/ci/fixtures/reference"   // F30 fixture

    // outputs: one scratch root, same tree shape as the real layout
    ci_out       = "${projectDir}/tests/ci/out"
    raw_qc_dir   = "${params.ci_out}/results/qc/fastqc_raw"
    trim_dir   = "${params.ci_out}/results/reads"
    trim_qc_dir   = "${params.ci_out}/results/qc/fastqc_trimmed"
    assembly_dir   = "${params.ci_out}/results/assembly"
    quast_dir   = "${params.ci_out}/results/qc/quast"
    refcomp_dir   = "${params.ci_out}/results/qc/refcompare"   // F30
    busco_dir   = "${params.ci_out}/results/qc/busco"
    annot_dir   = "${params.ci_out}/results/annotation"
    carveme_dir   = "${params.ci_out}/results/models/carveme"
    memote_dir   = "${params.ci_out}/results/models/memote"
    growth_dir   = "${params.ci_out}/results/models/growth"
    multiqc_dir   = "${params.ci_out}/results/report"
    logs_dir     = "${params.ci_out}/logs"
    bench_dir    = "${params.ci_out}/benchmarks"
}

conda {
    enabled = false
}

// ---------------------------------------------------------------------------
// CPU clamp -- why this is not optional.
//
// The GitHub runner for this repository reports **2 CPUs**, while
// nextflow.config declares up to 8 for the real tools. Nextflow refuses to
// schedule a task whose `cpus` exceeds the machine's CPU count:
//
//     ERROR ~ Error executing process > 'FASTQC_RAW (CI_A_1)'
//     Caused by: Task requirement exceeds available CPUs -- req: 4; avail: 2
//
// On the first real CI run (2026-10-15) that aborted the stub run immediately:
// the smoke job published nothing (65 artifact assertions then failed) and both
// inner runs of the failure-isolation job died the same way, which its
// assertions reported as a broken injection and a broken `-resume`.
//
// Stub tasks execute nothing, so clamp the request rather than weakening
// nextflow.config: `resourceLimits` caps a task's *effective* cpus, and as a
// single ceiling it also covers any process added later (an explicit
// `withName` list per process would silently rot). Verified locally by forcing
// an impossible request through a second overlay:
//     -c ci.config -c <probe: FASTQC_RAW cpus = 999>   -> "req: 999; avail: 8"
//     -c ci.config -c <probe: 999> -c <resourceLimits> -> 24 tasks submitted
// ---------------------------------------------------------------------------
process {
    resourceLimits = [cpus: 1]
}

// Nextflow's own execution report/trace are pinned to the REAL results tree at
// config-parse time (see the note in nextflow.config), so a check must switch them
// off rather than redirect them -- otherwise every CI run writes a 1.6 MB report
// into the validated outputs (F18 class).
report { enabled = false }
trace  { enabled = false }

workDir = "${params.ci_out}/work"
