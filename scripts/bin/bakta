#!/usr/bin/env python
"""
bakta wrapper that puts the AMRFinderPlus chunk guard in front of bakta.

`scripts/bin` is prepended to PATH by the bakta rule in the Snakefile, so this
file shadows the conda-installed `bakta` entry point. Everything else — argv,
exit code, stdout/stderr — is passed through unchanged.

Rationale and behaviour: see scripts/amr_guard/amr_chunk_guard.py
(upstream bug: ncbi/amr issue #191).
"""
import os
import sys

_GUARD_DIR = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "amr_guard"
)
sys.path.insert(0, _GUARD_DIR)

# Importing the guard installs the patch on bakta.expert.amrfinder.search.
import amr_chunk_guard  # noqa: E402,F401
from bakta.main import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
