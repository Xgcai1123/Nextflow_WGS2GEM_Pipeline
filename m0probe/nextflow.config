// ============================================================
// M0 probe config — verifies design-doc §12 checklist 1/3/4
// (checklist 2 is exercised by running a real env yaml: fastqc.yaml)
// ============================================================

params {
    probe_root = projectDir                       // checklist #1: is projectDir usable in nextflow.config?
    envs_dir   = "${projectDir}/../../WGSpipeline/envs"
    out_dir    = "${projectDir}/published"
}

conda {
    enabled  = true
    useMamba = true                               // faster solves; candidate for the real config (see write-back)
    cacheDir = "${projectDir}/conda-cache"
}

workDir = "${projectDir}/work"
